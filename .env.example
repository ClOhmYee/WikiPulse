# docker compose 용. .env 로 복사해서 채운다. .env 는 gitignore 대상이다.

# PostgreSQL
POSTGRES_DB=wikipulse
POSTGRES_USER=wikipulse
POSTGRES_PASSWORD=
# Compose는 백엔드에 연결한다. 예시 데이터를 보려면 mock으로 변경한다.
VITE_DATA_SOURCE=api
# 브라우저 → Vite → backend:8080. /api/v1 경로를 포함한다.
VITE_API_BASE_URL=/api/v1

# 파이프라인(--profile pipeline)을 쓸 때만 필요.
# Wikimedia 는 연락처 없는 User-Agent 를 차단한다.
CONTACT_EMAIL=you@example.com
WIKIS=enwiki

# 후보 생성 워커(backend)가 이슈 임베딩을 만들 때 쓴다. LLM 게이트웨이 키.
# 🔴 저장소에 넣지 않는다. 폴러(WIKIPULSE_MATCHING_SCHEDULER_ENABLED=true)를 켤 때 필수.
LLM_GATEWAY_KEY=
# 워커 셋은 각각 켠다. 순서가 있다 — 스케줄러(후보 생성)는 종목 임베딩이 전량
# 적재된 뒤, 검증은 PENDING 후보가 쌓인 뒤, 요약은 검증과 같은 GATEWAY 키를 쓴다.
WIKIPULSE_MATCHING_SCHEDULER_ENABLED=false
WIKIPULSE_MATCHING_VERIFICATION_ENABLED=false
WIKIPULSE_MATCHING_SUMMARY_ENABLED=false
# 요약의 실제 비용 상한 — 스냅샷별 pulse_score 상위 몇 개까지 요약할지. 0 = 무제한.
# ⚠️ BATCHSIZE 는 상한이 아니다. 폴마다 대상을 새로 고르므로 반복하면 전체를 훑는다.
WIKIPULSE_MATCHING_SUMMARY_TOPPERSNAPSHOT=10
# 후보 생성의 실제 비용 상한. 🔴 위 요약 상한과 같은 값으로 둔다 — 다르면 화면에서
# 요약은 있는데 종목이 없거나 그 반대가 생긴다.
WIKIPULSE_MATCHING_SCHEDULER_TOPPERSNAPSHOT=10
# 검증 모델. claude- 로 시작하면 Anthropic, 아니면 OpenAI 경로다.
# 기본 gpt-5.4-nano — Sonnet 대비 9.8배 저렴, 정답셋 오탐 0 (WP-170).
WIKIPULSE_MATCHING_GATEWAY_VERIFICATIONMODEL=gpt-5.4-nano
# 요약 모델. 🔴 요약은 nano 로 측정하지 않아 Sonnet 을 유지한다.
WIKIPULSE_MATCHING_GATEWAY_SUMMARYMODEL=claude-sonnet-4-5-20250929
# 문서 표시용 한국어 제목 채우기 워커 (WP-205). 위 셋과 독립이고 GATEWAY 를 안 쓴다.
# 🔴 켜는 것이 곧 백필이다. 끄면 화면이 영문 제목으로 떨어질 뿐이다.
WIKIPULSE_PAGETITLE_ENABLED=false
WIKIPULSE_PAGETITLE_BATCHSIZE=500
