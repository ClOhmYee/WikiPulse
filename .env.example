# docker compose 용. .env 로 복사해서 채운다. .env 는 gitignore 대상이다.

# PostgreSQL
POSTGRES_DB=wikipulse
POSTGRES_USER=wikipulse
POSTGRES_PASSWORD=
# 프론트가 부를 백엔드 주소 (브라우저 기준이라 localhost)
VITE_API_BASE_URL=http://localhost:8080

# 파이프라인(--profile pipeline)을 쓸 때만 필요.
# Wikimedia 는 연락처 없는 User-Agent 를 차단한다.
CONTACT_EMAIL=you@example.com
WIKIS=enwiki
