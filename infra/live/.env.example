# LIVE 상주 서비스 (infra/live/compose.yaml). 서비스(기본) EC2.
# 실제 값은 서버의 .env 에만 둔다 — 커밋 금지, mode 0600.
#
# 🔴 `.env` 를 고칠 때는 `infra/edit-env.sh` 를 쓴다 (WP-178).
#    `sed -i` 는 그룹 소유권을 날려 다음 배포를 죽인다 — 네 번 터졌다.

# DB — infra/db/.env · infra/service/.env 와 같은 값이어야 한다.
POSTGRES_DB=wikipulse
POSTGRES_USER=
POSTGRES_PASSWORD=

# Wikimedia 예절 — 연락처 없는 User-Agent 는 차단된다
CONTACT_EMAIL=

# Kafka (데이터 EC2)
KAFKA_BOOTSTRAP_SERVERS=192.0.2.10:9092
KAFKA_TOPIC=wiki.edits

# 🔴 코드가 오는 곳. 이미지가 아니라 이 디렉터리다 — 여기가 저장소보다 낡으면
#    고친 코드가 안 닿는다(WP-194 에서 24시간 그랬다).
LIVE_APP_DIR=/home/deploy/wikipulse-local-test/data-pipeline

# 🔴 `wikipulse-net` 이 아니다. 실물이 붙어 있는 네트워크다 — 틀리면 에러 없이
#    DNS 만 실패한다. 둘 다 서버에 존재한다.
LIVE_NETWORK=postgres_default

# docker/spark/Dockerfile 로 빌드한 이미지 (파이썬 3.11 고정, WP-136)
LIVE_IMAGE=wikipulse-spark-standalone:local

# 주기(초)
LIVE_CYCLE_INTERVAL=300
CLUSTER_LOOP_INTERVAL=300

RESTART_POLICY=unless-stopped
