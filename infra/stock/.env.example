# 종목 적재 (infra/stock/compose.yaml). 서비스(기본) EC2.
# 실제 값은 서버의 .env 에만 둔다 — 커밋 금지, mode 0600.

# DB — infra/db/.env · infra/service/.env 와 같은 값이어야 한다.
POSTGRES_DB=wikipulse
POSTGRES_USER=
POSTGRES_PASSWORD=

# 🔴 GATEWAY 키. embed 단계에서만 쓴다. universe·summaries 는 없어도 돈다.
LLM_GATEWAY_API_KEY=
LLM_GATEWAY_BASE_URL=https://llm-gateway.example.com/api.openai.com/v1

# 저장소 체크아웃의 data-pipeline 경로 (빌드 컨텍스트)
STOCK_APP_DIR=../../data-pipeline
