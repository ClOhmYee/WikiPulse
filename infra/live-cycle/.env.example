# LIVE 시간 주기 (infra/live-cycle/compose.yaml). 서비스(기본) EC2.
# 실제 값은 서버의 .env 에만 둔다 — 커밋 금지, mode 0600.

# DB — infra/db/.env · infra/service/.env 와 같은 값이어야 한다.
POSTGRES_DB=wikipulse
POSTGRES_USER=
POSTGRES_PASSWORD=

# Wikimedia 예절 — 연락처 없는 User-Agent 는 차단된다
CONTACT_EMAIL=

# 저장소 체크아웃의 data-pipeline 경로 (빌드 컨텍스트)
LIVE_CYCLE_APP_DIR=../../data-pipeline

# 주기(초)와 한 주기에 받을 시간 파일 수 상한
LIVE_CYCLE_INTERVAL=900
LIVE_CYCLE_MAX_HOURS=6

# canary 동안은 no. 게이트를 통과한 뒤 unless-stopped 로 바꾼다.
RESTART_POLICY=no
