# .env 로 복사해서 채운다. .env 는 gitignore 대상이다.

# 필수 — Wikimedia 는 연락처 없는 User-Agent 를 차단한다.
CONTACT_EMAIL=you@example.com

# Kafka. 호스트에서 프로듀서를 돌릴 때는 localhost:9092,
# 컨테이너 안에서는 kafka:29092 다.
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=wiki.edits

# 대상 위키. 쉼표로 여러 개, * 면 전 위키.
# 전 위키는 초당 약 31건, enwiki 만은 약 2건이다 (2026-09-04 실측).
WIKIS=enwiki

LOG_EVERY_SECONDS=30

# --- Spark 잡 (docker compose run spark) ---
# 급증 판정 수식이 확정되면 (WP-38) 기본값을 고정한다.
WINDOW_SIZE=1 hour
SLIDE_SIZE=5 minutes
STARTING_OFFSETS=latest

# --- GDELT 수집 producer (WP-32, python -m gdelt.producer) ---
# 로컬에서 직접 돌릴 땐 local 싱크. compose(gdelt 프로필)에선 webhdfs 로 뜬다.
GDELT_SINK=local
GDELT_LOCAL_DIR=gdelt-data
# webhdfs 로 쓸 때. ⚠️ WebHDFS 는 datanode 로 리다이렉트하므로 compose 네트워크
# 안에서 돌려야 한다. 호스트에서 직접 돌리면 GDELT_SINK=local 을 쓴다.
WEBHDFS_URL=http://hdfs-namenode:9870
HDFS_BASE_PATH=/gdelt/gkg
GDELT_GAPS_PATH=gdelt-data/gaps.json
# 매 폴링마다 되돌아보며 빠진 슬롯을 채우는 창(시간).
GDELT_SELFHEAL_HOURS=6
