{
  "name": "wikipulse-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5174 --strictPort",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4174 --strictPort",
    "lint": "eslint src --max-warnings 0",
    "test": "playwright test",
    "test:e2e": "playwright test",
    "test:a11y": "node scripts/accessibility.mjs",
    "test:contract": "node scripts/validate-contract.mjs && node scripts/validate-pulse-contract.mjs",
    "test:production": "node scripts/production-smoke.mjs",
    "format": "prettier --write src",
    "format:check": "prettier --check src",
    "test:data": "node --test tests/*.test.js",
    "test:api": "playwright test --config playwright.api.config.js"
  },
  "dependencies": {
    "@fontsource-variable/noto-sans-kr": "5.3.0",
    "@fontsource/barlow-condensed": "5.3.0",
    "@react-three/fiber": "9.7.0",
    "d3-force": "3.0.0",
    "lucide-react": "1.37.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "0.185.1"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@vitejs/plugin-react": "6.1.1",
    "ajv": "6.15.0",
    "axe-core": "4.13.0",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "js-yaml": "4.3.2",
    "prettier": "3.6.2",
    "vite": "8.2.2"
  }
}
